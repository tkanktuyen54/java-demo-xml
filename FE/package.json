{
  "name": "khoa-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "test:chat": "node --experimental-strip-types --test src/app/core/chat-stream.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "prettier": "3.9.10",
    "typescript": "~6.0.2"
  }
}
